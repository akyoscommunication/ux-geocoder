{
  "name": "@akyoscommunication/ux-geocoder",
  "description": "UX fields geocoder for Symfony using php-geocoder",
  "main": "dist/main.js",
  "version": "1.0.0",
  "license": "MIT",
  "config": {
    "css_source": "src/app.css"
  },
  "symfony": {
    "controllers": {
      "ux-geocoder-tomselect": {
